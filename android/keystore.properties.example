# Copy to android/keystore.properties (gitignored) after creating a key, for example:
#   keytool -genkeypair -v -keystore hargatetangga-release.jks -alias hargatetangga -keyalg RSA -keysize 2048 -validity 10000
# Keep the .jks file and passwords safe: losing them means a store listing can never be updated.
storeFile=hargatetangga-release.jks
storePassword=
keyAlias=hargatetangga
keyPassword=
